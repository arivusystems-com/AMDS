# Copy to .env for local development
# cp .env.example .env
#
# Full variable reference: docs/TRACK-2-COMPLETE.md · docs/BUILD-TO-DEPLOY.md

AMDS_PORT=8080
NODE_ENV=development

# Docker Compose services (docker compose up -d)
DATABASE_URL=postgresql://amds:amds@localhost:5432/amds
REDIS_URL=redis://localhost:6379

# Local SMTP — Mailpit (no real delivery, no port 25)
# Use SMTP_MODE=direct on OCI for MX delivery
SMTP_MODE=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_MAX_ATTEMPTS=6
SMTP_RETRY_DELAY_MS=5000

# Per-tenant rate limit (POST /v1/messages)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60

# Webhook retry to LiteDesk
WEBHOOK_MAX_ATTEMPTS=15
WEBHOOK_RETRY_DELAY_MS=60000

# Track 3 — domains, DKIM, DNS verification
AMDS_SPF_INCLUDE=amds.local
DKIM_DEFAULT_SELECTOR=amds1
DNS_VERIFY_BYPASS=false
ENFORCE_DOMAIN_VERIFICATION=false

# Track 4 — campaigns, open/click tracking
TRACKING_BASE_URL=http://localhost:8080
CAMPAIGN_WORKER_CONCURRENCY=2

# Track 5 — production hardening
TRANSACTION_WORKER_CONCURRENCY=5
WEBHOOK_WORKER_CONCURRENCY=3
SHUTDOWN_GRACE_MS=800
METRICS_ENABLED=true
WORKER_METRICS_PORT=9091

# Track 6 Phase 1 — tenant policies & credits (LiteDesk sync)
# When true, POST /v1/messages requires PUT /v1/tenants/:id/policy first
TENANT_POLICIES_REQUIRED=false

# Track 6 Phase 2 — sender reputation
REPUTATION_DEFAULT_SCORE=70
REPUTATION_MAX_DELTA=5

# Track 6 Phase 3 — dynamic throughput & warm-up
WARMUP_DISABLE_REPUTATION_SCORE=85
WARMUP_DISABLE_MIN_DAYS=7
INFRA_QUEUE_DEPTH_THRESHOLD=1000
TRANSACTION_THROUGHPUT_FLOOR=0.25
REPUTATION_MARKETING_MIN=40
REPUTATION_SEND_MIN=20

# Track 6 Phase 5 — infrastructure protection & recovery
REPUTATION_MAX_DAILY_GAIN=5
REPUTATION_BLACKLIST_PENALTY=15
REPUTATION_SPAM_TRAP_PENALTY=25
INFRA_SMTP_FAILURE_THRESHOLD=0.15
INFRA_SMTP_WINDOW_MINUTES=5
EGRESS_IP=default
EGRESS_IP_TRANSACTION=default-tx
EGRESS_IP_MARKETING=default-mkt
# Optional read replica for reputation history queries
# DATABASE_READ_URL=postgresql://amds:amds@localhost:5432/amds

# Auth
AMDS_API_KEY=amds_dev_key
WEBHOOK_SIGNING_SECRET=dev_webhook_secret

# LiteDesk webhook target (AMDS worker posts delivery events here)
LITEDESK_WEBHOOK_URL=http://localhost:3000/api/internal/webhooks/amds

# Default sender for local testing
DEFAULT_FROM_EMAIL=noreply@localhost.test
DEFAULT_FROM_NAME=AMDS Local
